# ==============================================================================
# CMS Data Quality & Ingestion Pipeline — Deployment Makefile
# ==============================================================================
# Intent:
#   Deterministic deployment orchestration for Docker + Compose execution.
#   Invoked from repository root via:
#
#       make deploy
#
# Determinism Guarantees:
#   - Pinned Dockerfile (deployment/Dockerfile)
#   - Pinned Compose file (compose.yml)
#   - Read‑only mounts for code/configs
#   - Stable artifact + log directories
# ==============================================================================

# ==============================================================================
# Variables
# ==============================================================================
# Note: C++ mechanization binaries are built in CI (make cpp-all) and included via src/.
# ==============================================================================

PROJECT_ROOT := ..
DOCKERFILE := deployment/Dockerfile
COMPOSE := ../compose.yml
IMAGE_NAME := cms_ingestion
IMAGE_TAG := latest

VERSION ?= dev

# ==============================================================================
# Help — Self‑Documenting
# ==============================================================================

.PHONY: help

help:
	@echo ""
	@echo "CMS Deployment — Commands"
	@echo "-------------------------"
	@grep -E '^[a-zA-Z0-9_-]+:.*##' Makefile.deploy \
		| sed -E 's/^(.*):.*##(.*)/\1:\2/' \
		| sed -E 's/^([^:]+):/\1:  /'
	@echo ""

# ==============================================================================
# Docker Build — Deterministic
# ==============================================================================
# C++ mechanization (utils_cpp/) is built inside the Docker image via deployment/Dockerfile.
# No host-side C++ build occurs in deployment Makefile.
# ==============================================================================

.PHONY: docker-build

docker-build: ## Build deterministic Docker image
	@echo "=== Building deterministic Docker image ==="
	docker build -f ../$(DOCKERFILE) -t $(IMAGE_NAME):$(IMAGE_TAG) ..

# ==============================================================================
# Docker Run — Deterministic (No Compose)
# ==============================================================================
# Includes deterministic C++ mechanization layer (utils_cpp/) mounted read-only.
# ==============================================================================

.PHONY: docker-run

docker-run: ## Run pipeline inside Docker image (no Compose)
	@echo "=== Running pipeline inside Docker image ==="
	docker run --rm \
		-v $(PROJECT_ROOT)/configs:/app/configs:ro \
		-v $(PROJECT_ROOT)/src:/app/src:ro \
		-v $(PROJECT_ROOT)/utils:/app/utils:ro \
		-v $(PROJECT_ROOT)/scripts:/app/scripts:ro \
		-v $(PROJECT_ROOT)/deployment:/app/deployment:ro \
		-v $(PROJECT_ROOT)/data:/app/data \
		-v $(PROJECT_ROOT)/logs:/app/logs \
		$(IMAGE_NAME):$(IMAGE_TAG)

# ==============================================================================
# Compose Up / Down / Restart
# ==============================================================================

.PHONY: compose-up compose-down compose-restart

compose-up: ## Start full deployment environment using Compose
	@echo "=== Starting deterministic deployment environment ==="
	docker compose -f $(COMPOSE) up --build

compose-down: ## Shut down deployment environment
	@echo "=== Shutting down deployment environment ==="
	docker compose -f $(COMPOSE) down

compose-restart: ## Restart deployment environment
	@echo "=== Restarting deployment environment ==="
	docker compose -f $(COMPOSE) down
	docker compose -f $(COMPOSE) up --build

# ==============================================================================
# Release Artifact Validation
# ==============================================================================

.PHONY: validate-manifest validate-sbom validate-provenance validate-signature

validate-manifest: ## Validate manifest for VERSION
	@echo "=== Validating manifest.json for version $(VERSION) ==="
	cd $(PROJECT_ROOT) && \
	PYTHONPATH=".:./src:./scripts" \
		python deployment/scripts/validate_manifest.py $(VERSION)

validate-sbom: ## Validate SBOM for VERSION
	@echo "=== Validating SBOM for version $(VERSION) ==="
	cd $(PROJECT_ROOT) && \
	PYTHONPATH=".:./src:./scripts" \
		python deployment/scripts/validate_sbom.py $(VERSION)

validate-provenance: ## Validate provenance for VERSION
	@echo "=== Validating provenance for version $(VERSION) ==="
	cd $(PROJECT_ROOT) && \
	PYTHONPATH=".:./src:./scripts" \
		python deployment/scripts/validate_provenance.py $(VERSION)

validate-signature: ## Validate detached signature for VERSION
	@echo "=== Validating signature for version $(VERSION) ==="
	cd $(PROJECT_ROOT) && \
	PYTHONPATH=".:./src:./scripts" \
		python deployment/scripts/validate_signature.py $(VERSION)

# ==============================================================================
# Clean Deployment Artifacts
# ==============================================================================

.PHONY: clean docker-clean

clean: ## Remove data + logs (safe)
	@echo "=== Cleaning data + logs ==="
	rm -rf $(PROJECT_ROOT)/data/*
	rm -rf $(PROJECT_ROOT)/logs/*

docker-clean: ## Remove dangling Docker images + containers
	@echo "=== Cleaning Docker artifacts ==="
	docker system prune -f
	docker volume prune -f

# ==============================================================================
# Full Deterministic Deployment (Build → Up → Validate)
# ==============================================================================

.PHONY: deploy deploy-ci

deploy: ## Full deterministic deployment run
	$(MAKE) -f Makefile.deploy docker-build
	$(MAKE) -f Makefile.deploy compose-up
	$(MAKE) -f Makefile.deploy validate-manifest VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-sbom VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-provenance VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-signature VERSION=$(VERSION)

deploy-ci: ## CI-style deterministic deployment validation
	$(MAKE) -f Makefile.deploy docker-build
	$(MAKE) -f Makefile.deploy validate-manifest VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-sbom VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-provenance VERSION=$(VERSION)
	$(MAKE) -f Makefile.deploy validate-signature VERSION=$(VERSION)
