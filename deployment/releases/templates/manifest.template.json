{
    "version": "<VERSION>",
    "release_date": "<YYYY-MM-DD>",
    "provenance": {
        "pipeline_version": "<VERSION>",
        "schema_version": "<SCHEMA_VERSION>",
        "artifact_version": "<VERSION>",
        "manifest_version": "<MANIFEST_SCHEMA_VERSION>",
        "deployment_version": "<DEPLOYMENT_VERSION>",
        "sbom_version": "<VERSION>",
        "validated_at": null,
        "component_count": "<TO_BE_FILLED>",
        "dependencies_count": "<TO_BE_FILLED>",
        "artifact_count": "<TO_BE_FILLED>"
    },
    "artifacts": {
        "docker_image": {
            "name": "cms-pipeline:<VERSION>",
            "digest": "sha256:<TO_BE_FILLED>"
        },
        "helm_chart": {
            "path": "deployment/helm/Chart.yml",
            "version": "<VERSION>",
            "digest": "sha256:<TO_BE_FILLED>"
        },
        "k8s_manifests": {
            "deployment": "deployment/k8s/deployment.yml",
            "service": "deployment/k8s/service.yml",
            "digest": "sha256:<TO_BE_FILLED>"
        },
        "terraform_module": {
            "path": "deployment/terraform/",
            "digest": "sha256:<TO_BE_FILLED>"
        },
        "sbom": {
            "path": "deployment/sbom/sbom-<VERSION>.json",
            "digest": "sha256:<TO_BE_FILLED>"
        },
        "audit_logs": {
            "generator": "deployment/scripts/generate_audit_logs.py",
            "digest": "sha256:<TO_BE_FILLED>"
        }
    },
    "ci_cd": {
        "workflow": "deployment/ci/github-actions.yml",
        "run_id": "<GITHUB_RUN_ID>",
        "commit_sha": "<GITHUB_SHA>"
    },
    "validation": {
        "provenance_validator": "deployment/scripts/validate_provenance.py",
        "sbom_validator": "deployment/scripts/validate_sbom.py",
        "manifest_validator": "deployment/scripts/validate_manifest.py",
        "drift_detection": "deployment/Makefile.deploy",
        "status": "pending"
    }
}