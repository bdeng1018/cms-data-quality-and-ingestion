{
    "version": "<VERSION>",
    "schema_version": "<MANIFEST_SCHEMA_VERSION>",
    "generated_at": "<ISO8601_TIMESTAMP>",
    "artifacts": {
        "manifest": {
            "path": "deployment/releases/<VERSION>.manifest.json",
            "digest": "sha256:{{ manifest_digest }}"
        },
        "docker_image": {
            "name": "ghcr.io/<GHCR_NAMESPACE>/cms-pipeline:<VERSION>",
            "digest": "sha256:{{ docker_digest }}"
        },
        "sbom": {
            "path": "deployment/sbom/sbom-<VERSION>.json",
            "digest": "sha256:{{ sbom_digest }}"
        },
        "provenance": {
            "path": "deployment/provenance/provenance-<VERSION>.json",
            "digest": "sha256:{{ provenance_digest }}"
        }
    },
    "metadata": {
        "repository": "<REPOSITORY_URL>",
        "deployment_version": "<DEPLOYMENT_VERSION>",
        "python_version": "<PYTHON_VERSION>",
        "docker_version": "<DOCKER_VERSION>"
    },
    "validation": {
        "status": ""
    }
}